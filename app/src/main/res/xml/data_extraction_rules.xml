<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer, minus the Last.fm sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ghostly_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ghostly_account.xml" />
    </device-transfer>
</data-extraction-rules>
